load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "screw",
    srcs = ["src/screw.cpp"],
    hdrs = ["include/factory/screw_drive.hpp"],
    strip_include_prefix = "include",
    deps = ["//native/geared-cycle:clock"],
)

cc_library(
    name = "workbench",
    srcs = ["src/workbench.cpp"],
    hdrs = ["include/factory/screw_workbench.hpp"],
    strip_include_prefix = "include",
    deps = [":screw", "//native/geared-cycle:workbench"],
)

cc_binary(
    name = "screw_workbench",
    srcs = ["src/main.cpp"],
    deps = [":workbench"],
)

cc_test(
    name = "screw_test",
    srcs = ["tests/screw_test.cpp"],
    deps = [":workbench"],
    size = "small",
)
