load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "admission",
    srcs = ["src/admission.cpp"],
    hdrs = ["include/factory/slotted_workcell.hpp"],
    strip_include_prefix = "include",
    deps = ["//native/slotted-pairs:pairs"],
)

cc_library(
    name = "workbench",
    srcs = ["src/workbench.cpp"],
    hdrs = ["include/factory/slotted_workcell_workbench.hpp"],
    strip_include_prefix = "include",
    deps = [":admission"],
)

cc_binary(
    name = "slotted_workcell_workbench",
    srcs = ["src/main.cpp"],
    deps = [":workbench"],
)

cc_test(
    name = "workcell_test",
    size = "small",
    srcs = ["tests/workcell_test.cpp"],
    deps = [":admission"],
)
