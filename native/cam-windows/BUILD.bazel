load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "windows",
    srcs = ["src/windows.cpp"],
    hdrs = ["include/factory/cam_windows.hpp"],
    strip_include_prefix = "include",
    deps = ["//native/geared-cycle:clock", "//native/mechanisms:cycle"],
)

cc_library(
    name = "workbench",
    srcs = ["src/workbench.cpp"],
    hdrs = ["include/factory/cam_windows_workbench.hpp"],
    strip_include_prefix = "include",
    deps = [":windows", "//native/geared-cycle:workbench"],
)

cc_binary(
    name = "cam_windows_case",
    srcs = ["src/main.cpp"],
    deps = [":workbench"],
)

cc_test(
    name = "windows_test",
    srcs = ["tests/windows_test.cpp"],
    deps = [":workbench"],
    size = "small",
)
