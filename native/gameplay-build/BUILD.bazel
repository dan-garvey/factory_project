load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:private"])

exports_files(["production-paths.txt"], visibility = ["//visibility:private"])

cc_library(
    name = "build",
    srcs = ["build.cpp"],
    hdrs = ["build.hpp"],
    deps = ["//native/build-support:runner", "//native/factory-launch:capture"],
)

cc_binary(
    name = "factory-gameplay-build",
    srcs = ["main.cpp"],
    deps = [":build"],
    visibility = ["//visibility:public"],
)

cc_test(
    name = "install_test",
    srcs = ["tests.cpp"],
    data = [":factory-gameplay-build", ":production-paths.txt", "//:scripts/ensure-gameplay-library.sh", "//:scripts/ensure-startup-launcher.sh"],
    deps = [":build", "//native/factory-launch:capture"],
    tags = ["host"],
    size = "small",
)

cc_test(
    name = "launch_refresh_guard_test",
    srcs = ["launch_guard_tests.cpp"],
    data = ["//:scripts/tests/ensure-gameplay-library.sh", "//:scripts/ensure-gameplay-library.sh"],
    deps = ["//native/factory-launch:capture"],
    tags = ["host"],
    size = "small",
)
