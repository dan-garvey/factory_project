load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "loop",
    srcs = ["src/loop.cpp"],
    hdrs = ["include/factory/pulley_loop.hpp"],
    strip_include_prefix = "include",
    deps = ["//native/pulley-pair:pair"],
)

cc_library(
    name = "workbench",
    srcs = ["src/workbench.cpp"],
    hdrs = ["include/factory/pulley_loop_workbench.hpp"],
    strip_include_prefix = "include",
    deps = [":loop", "//native/geared-cycle:workbench"],
)

cc_binary(
    name = "loop_case",
    srcs = ["src/main.cpp"],
    deps = [":workbench"],
)

cc_test(
    name = "loop_test",
    size = "small",
    srcs = ["tests/loop_test.cpp"],
    deps = [":workbench"],
)
