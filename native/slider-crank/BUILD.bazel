load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "crank",
    srcs = ["src/crank.cpp"],
    hdrs = ["include/factory/slider_crank.hpp"],
    strip_include_prefix = "include",
    deps = ["//native/scotch-yoke:yoke"],
)

cc_library(
    name = "workbench",
    srcs = ["src/workbench.cpp"],
    hdrs = ["include/factory/slider_crank_workbench.hpp"],
    strip_include_prefix = "include",
    deps = [":crank", "//native/geared-cycle:workbench"],
)

cc_binary(
    name = "slider_case",
    srcs = ["src/main.cpp"],
    deps = [":workbench"],
)

cc_test(
    name = "crank_test",
    size = "small",
    srcs = ["tests/crank_test.cpp"],
    deps = [":workbench"],
)
