load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "git_reader",
    hdrs = ["git_reader.hpp"],
)

cc_library(
    name = "coordinator",
    srcs = ["coordinator.cpp"],
    hdrs = ["coordinator.hpp"],
    deps = [":git_reader", ":native_selection", "//native/tooling:local_resources"],
)

cc_library(
    name = "staged_tree",
    srcs = ["staged_tree.cpp"],
    hdrs = ["staged_tree.hpp"],
    deps = [":git_reader", "//native/validation:tree_manifest"],
)

cc_library(
    name = "native_selection",
    srcs = ["native_selection.cpp"],
    hdrs = ["native_selection.hpp"],
)

cc_library(
    name = "native_worker",
    srcs = ["native_worker.cpp"],
    hdrs = ["native_worker.hpp"],
    deps = [
        ":coordinator",
        ":native_selection",
        ":staged_tree",
        "//native/build-support:runner",
        "//native/factory-launch:capture",
        "//native/tooling:local_resources",
    ],
)

cc_test(
    name = "native_selection_test",
    srcs = ["native_selection_tests.cpp"],
    deps = [":native_selection"],
    size = "small",
)

cc_test(
    name = "native_worker_test",
    srcs = ["native_worker_tests.cpp"],
    deps = [":native_worker"],
    size = "small",
)

cc_test(
    name = "staged_tree_test",
    srcs = ["staged_tree_tests.cpp"],
    deps = [":staged_tree", "//native/factory-launch:capture"],
    size = "small",
    tags = ["host"],
)

cc_binary(
    name = "factory-commit-check",
    srcs = ["main.cpp"],
    deps = [":coordinator", ":native_worker"],
)

cc_test(
    name = "coordinator_test",
    srcs = ["tests.cpp"],
    args = ["$(rootpath :factory-commit-check)"],
    data = [":factory-commit-check"],
    deps = [":coordinator", "//native/factory-launch:capture"],
    size = "small",
    timeout = "short",
    tags = ["host", "local"],
)

cc_test(
    name = "hook_dispatch_test",
    srcs = ["dispatch_tests.cpp"],
    args = ["$(rootpath //:.githooks/pre-commit)"],
    data = ["//:.githooks/pre-commit"],
    deps = ["//native/factory-launch:capture"],
    # This fixture copies itself into an isolated repository to test exec.
    linkstatic = True,
    size = "small",
    tags = ["host", "local"],
)
