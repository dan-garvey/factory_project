load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

cc_library(
    name = "tuft",
    srcs = ["tuft.cpp"],
    hdrs = ["tuft.hpp"],
    copts = ["-std=c++20", "-Wall", "-Wextra", "-Wpedantic", "-Werror"],
)

cc_binary(
    name = "pack_tuft",
    srcs = ["main.cpp"],
    copts = ["-std=c++20", "-Wall", "-Wextra", "-Wpedantic", "-Werror"],
    deps = [":tuft"],
)

cc_test(
    name = "tuft_test",
    srcs = ["tuft_test.cpp"],
    copts = ["-std=c++20", "-Wall", "-Wextra", "-Wpedantic", "-Werror"],
    deps = [":tuft"],
    size = "small",
)
