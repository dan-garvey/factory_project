load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:private"])

cc_library(
    name = "challenge",
    srcs = ["src/challenge.cpp", "src/projection.cpp"],
    hdrs = ["include/factory/opening_engineering.hpp"],
    strip_include_prefix = "include",
    visibility = ["//native/factory-godot-world:__pkg__"],
    deps = ["//native/factory-core:materials", "//native/factory-godot-world:host", "//native/factory-mechanics:mechanics"],
)

cc_test(
    name = "challenge_test",
    srcs = ["tests/challenge_test.cpp"],
    deps = [":challenge", "//native/factory-godot-world:test_site"],
    size = "small",
)

cc_test(
    name = "projection_test",
    srcs = ["tests/projection_test.cpp"],
    deps = [":challenge"],
    size = "small",
)
