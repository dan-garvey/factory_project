load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:private"])

cc_library(
    name = "transactions",
    hdrs = ["include/factory/transactions.hpp"],
    strip_include_prefix = "include",
    deps = ["//native/factory-authority:authority_boundary"],
    visibility = ["//native/factory-core:__pkg__"],
)

cc_test(
    name = "transactions_test",
    srcs = ["tests/transactions_test.cpp"],
    deps = [":transactions"],
    size = "small",
)

cc_library(
    name = "crank_command_contract",
    hdrs = ["include/factory/crank_command_contract.hpp"],
    strip_include_prefix = "include",
    deps = ["//native/factory-value:value"],
    visibility = ["//native/factory-godot-world:__pkg__"],
)

cc_library(
    name = "world",
    srcs = [
        "src/harvest_planner.cpp",
        "src/harvest_planner.hpp",
        "src/plan_common.cpp",
        "src/plan_common.hpp",
        "src/world.cpp",
    ],
    hdrs = ["include/factory/world.hpp"],
    strip_include_prefix = "include",
    deps = [
        ":crank_command_contract",
        ":transactions",
        "//native/factory-assembly:assembly",
        "//native/factory-core:materials",
        "//native/factory-core:recovery",
        "//native/factory-stationary:stationary",
        "//native/waterwheel:waterwheel",
    ],
    visibility = ["//native/repair-scenarios:__pkg__"],
)

cc_test(
    name = "world_test",
    srcs = ["tests/world_test.cpp"],
    deps = [":world"],
    size = "small",
)

cc_test(
    name = "broad_press_drive_world_test",
    srcs = ["tests/broad_press_drive_world_test.cpp"],
    deps = [":world"],
    size = "small",
)

cc_test(
    name = "world_scale_test",
    srcs = ["tests/world_scale_test.cpp"],
    deps = [":world"],
    size = "medium",
)

cc_test(
    name = "world_modular_scale_test",
    srcs = ["tests/world_modular_scale_test.cpp", "tests/harvest_fixture.hpp"],
    deps = [":checkpoint"],
    size = "medium",
)

cc_test(
    name = "world_belt_scale_test",
    srcs = ["tests/world_belt_scale_test.cpp", "tests/harvest_fixture.hpp"],
    deps = [":checkpoint"],
    size = "medium",
)

cc_library(
    name = "checkpoint",
    srcs = ["src/checkpoint.cpp"],
    hdrs = ["include/factory/checkpoint.hpp"],
    strip_include_prefix = "include",
    deps = [":world", "//native/factory-core:material_state_codec"],
    visibility = ["//native/factory-godot-world:__pkg__"],
)

cc_test(
    name = "checkpoint_test",
    srcs = ["tests/checkpoint_test.cpp"],
    deps = [":checkpoint"],
    size = "small",
)

cc_test(
    name = "cog_construction_test",
    srcs = ["tests/cog_construction_test.cpp"],
    deps = [":checkpoint"],
    size = "small",
)

cc_test(
    name = "landing_pod_test",
    srcs = ["tests/landing_pod_test.cpp", "tests/harvest_fixture.hpp"],
