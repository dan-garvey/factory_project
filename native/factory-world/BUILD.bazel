    size = "small",
)

cc_test(
    name = "harvest_world_test",
    srcs = ["tests/harvest_world_test.cpp"],
    deps = [":world", ":checkpoint", "//native/factory-value:value"],
    size = "small",
)

cc_test(
    name = "collector_belt_test",
