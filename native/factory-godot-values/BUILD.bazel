load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:private"])

cc_library(
    name = "godot_values",
    srcs = ["src/godot_value.cpp"],
    hdrs = [
        "include/factory/godot_value.hpp",
        "vendor/gdextension_interface.h",
    ],
    includes = ["include", "vendor"],
    copts = ["-std=c++20", "-Wall", "-Wextra", "-Wpedantic", "-Werror"],
    deps = ["//native/factory-value:value"],
    visibility = ["//native/factory-godot-world:__pkg__"],
)

cc_test(
    name = "api_table_test",
    srcs = ["tests/api_table_test.cpp"],
    copts = ["-std=c++20", "-Wall", "-Wextra", "-Wpedantic", "-Werror"],
    deps = [":godot_values"],
)

# This module has only invented adapter checks. It is never a game entry point.
cc_binary(
    name = "factory-value-abi-fixture.so",
    srcs = ["tests/abi_fixture.cpp"],
    copts = ["-std=c++20", "-Wall", "-Wextra", "-Wpedantic", "-Werror"],
    linkshared = True,
    linkstatic = True,
    deps = [":godot_values"],
)

filegroup(
    name = "abi_fixture_config",
    srcs = ["tests/project.godot", "tests/boundary.gdextension"],
)
