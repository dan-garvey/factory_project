load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "clamp",
    srcs = ["src/clamp.cpp"],
    hdrs = ["include/factory/crank_clamp.hpp"],
    strip_include_prefix = "include",
    deps = ["//native/slider-crank:crank"],
)

cc_library(
    name = "workbench",
    srcs = ["src/workbench.cpp"],
    hdrs = ["include/factory/crank_clamp_workbench.hpp"],
    strip_include_prefix = "include",
    deps = [":clamp", "//native/geared-cycle:workbench"],
)

cc_binary(
    name = "clamp_case",
    srcs = ["src/main.cpp"],
    deps = [":workbench"],
)

cc_test(
    name = "clamp_test",
    size = "small",
    srcs = ["tests/clamp_test.cpp"],
    deps = [":workbench"],
)
