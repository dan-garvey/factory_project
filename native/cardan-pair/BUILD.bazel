load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "pair",
    srcs = ["src/pair.cpp"],
    hdrs = ["include/factory/cardan_pair.hpp"],
    strip_include_prefix = "include",
    deps = ["//native/geared-cycle:clock"],
)

cc_library(
    name = "workbench",
    srcs = ["src/workbench.cpp"],
    hdrs = ["include/factory/cardan_pair_workbench.hpp"],
    strip_include_prefix = "include",
    deps = [":pair", "//native/geared-cycle:workbench"],
)

cc_binary(
    name = "cardan_case",
    srcs = ["src/main.cpp"],
    deps = [":workbench"],
)

cc_test(
    name = "pair_test",
    size = "small",
    srcs = ["tests/pair_test.cpp"],
    deps = [":workbench"],
)

cc_test(
    name = "consumer_test",
    size = "small",
    srcs = ["tests/pair_test.cpp"],
    args = ["--consumer-only"],
    deps = [":workbench"],
)

cc_test(
    name = "framing_test",
    size = "small",
    srcs = ["tests/pair_test.cpp"],
    args = ["--framing-only"],
    deps = [":workbench"],
)
