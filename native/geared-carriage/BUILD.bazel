load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "carriage",
    srcs = ["src/carriage.cpp"],
    hdrs = ["include/factory/geared_carriage.hpp"],
    strip_include_prefix = "include",
    deps = ["//native/geared-cycle:clock", "//native/mechanisms:cycle", "//native/motion-clearance:clearance"],
)

cc_library(
    name = "workbench",
    srcs = ["src/workbench.cpp"],
    hdrs = ["include/factory/geared_carriage_workbench.hpp"],
    strip_include_prefix = "include",
    deps = [":carriage", "//native/geared-cycle:workbench"],
)

cc_binary(
    name = "geared_carriage_workbench",
    srcs = ["src/main.cpp"],
    deps = [":workbench"],
)

cc_test(
    name = "carriage_test",
    srcs = ["tests/carriage_test.cpp"],
    deps = [":workbench"],
    size = "small",
)
