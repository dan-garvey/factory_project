load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "value",
    srcs = ["src/value.cpp"],
    hdrs = ["include/factory/value.hpp"],
    includes = ["include"],
    copts = ["-std=c++20", "-Wall", "-Wextra", "-Wpedantic", "-Werror"],
