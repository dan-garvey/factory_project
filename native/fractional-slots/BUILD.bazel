load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "admission",
    srcs = ["src/admission.cpp"],
    hdrs = ["include/factory/fractional_slots.hpp"],
    strip_include_prefix = "include",
    deps = ["//native/slotted-workcell:admission"],
)

cc_library(
    name = "workbench",
    srcs = ["src/workbench.cpp"],
    hdrs = ["include/factory/fractional_slots_workbench.hpp"],
    strip_include_prefix = "include",
    deps = [":admission"],
)

cc_binary(
    name = "fractional_slots_workbench",
    srcs = ["src/main.cpp"],
    deps = [":workbench"],
)

cc_test(
    name = "fractional_slots_test",
    size = "small",
    srcs = ["tests/fractional_slots_test.cpp"],
    deps = [":workbench"],
)
