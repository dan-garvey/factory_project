load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "gantries",
    srcs = ["src/gantries.cpp"],
    hdrs = ["include/factory/gantries.hpp"],
    strip_include_prefix = "include",
    deps = ["//native/mechanisms:cycle", "//native/motion-clearance:clearance"],
)

cc_library(
    name = "workbench",
    srcs = ["src/workbench.cpp"],
    hdrs = ["include/factory/gantry_workbench.hpp"],
    strip_include_prefix = "include",
    deps = [":gantries"],
)

cc_binary(
    name = "gantry_workbench",
    srcs = ["src/main.cpp"],
    deps = [":workbench"],
)

cc_test(
    name = "gantries_test",
    srcs = ["tests/gantries_test.cpp"],
    deps = [":gantries", ":workbench"],
    size = "small",
)
