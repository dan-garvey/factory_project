load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "scenarios",
    srcs = ["src/scenarios.cpp"],
    hdrs = ["include/factory/repair_scenarios.hpp"],
    strip_include_prefix = "include",
    deps = ["//native/factory-world:world"],
)

cc_test(
    name = "scenarios_test",
    srcs = ["tests/scenarios_test.cpp"],
    deps = [":scenarios"],
    size = "small",
)

cc_library(
    name = "workbench",
    srcs = ["src/workbench.cpp"],
    hdrs = ["include/factory/repair_workbench.hpp"],
    strip_include_prefix = "include",
    deps = [
        ":scenarios",
        "//native/gear-repairs:scenarios",
        "//native/co-drive-repairs:scenarios",
        "//native/service-repairs:scenarios",
    ],
)

cc_binary(
    name = "repair_workbench",
    srcs = ["src/main.cpp"],
    deps = [":workbench"],
)

cc_test(
    name = "workbench_test",
    srcs = ["tests/workbench_test.cpp"],
    deps = [":workbench"],
    size = "small",
)
