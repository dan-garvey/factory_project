load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "stroke",
    srcs = ["src/stroke.cpp"],
    hdrs = ["include/factory/tusi_stroke.hpp"],
    strip_include_prefix = "include",
    deps = ["//native/slider-crank:crank"],
)

cc_library(
    name = "workbench",
    srcs = ["src/workbench.cpp"],
    hdrs = ["include/factory/tusi_stroke_workbench.hpp"],
    strip_include_prefix = "include",
    deps = [":stroke", "//native/geared-cycle:workbench"],
)

cc_binary(
    name = "tusi_case",
    srcs = ["src/main.cpp"],
    deps = [":workbench"],
)

cc_test(
    name = "stroke_test",
    size = "small",
    srcs = ["tests/stroke_test.cpp"],
    deps = [":workbench"],
)
