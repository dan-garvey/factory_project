load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "material_types",
    hdrs = ["include/factory/materials.hpp", "include/factory/recovery.hpp"],
    strip_include_prefix = "include",
)

cc_library(
    name = "materials",
    srcs = ["src/materials.cpp"],
    deps = [":material_types"],
)

cc_library(
    name = "recovery",
    srcs = ["src/recovery.cpp"],
    deps = [":material_types", ":materials"],
)

cc_library(
    name = "material_state_codec",
    srcs = ["src/material_state_codec.cpp"],
    hdrs = ["include/factory/material_state_codec.hpp"],
    strip_include_prefix = "include",
    deps = [":materials", "//native/factory-value:value"],
)

cc_binary(
    name = "material_case",
    srcs = ["src/material_case.cpp"],
    deps = [":materials"],
)

cc_test(
    name = "materials_test",
    srcs = ["tests/materials_test.cpp"],
    deps = [":materials"],
    size = "small",
)

cc_test(
    name = "recovery_test",
    srcs = ["tests/recovery_test.cpp"],
    deps = [":recovery"],
    size = "small",
)

cc_test(
    name = "recovery_transaction_test",
    srcs = ["tests/recovery_transaction_test.cpp"],
    deps = [":recovery", "//native/factory-world:transactions"],
    size = "small",
)

cc_test(
    name = "material_state_codec_test",
    srcs = ["tests/material_state_codec_test.cpp"],
    deps = [":material_state_codec"],
    size = "small",
)

cc_test(
    name = "material_power_test",
    srcs = ["tests/material_power_test.cpp"],
    deps = [":materials"],
    size = "small",
)

cc_test(
    name = "copper_mass_test",
    srcs = ["tests/copper_mass_test.cpp"],
    deps = [":material_state_codec"],
    size = "small",
)

cc_test(
    name = "harvest_material_test",
    srcs = ["tests/harvest_material_test.cpp"],
    deps = [":material_state_codec"],
    size = "small",
)

cc_test(
    name = "component_craft_test",
    srcs = ["tests/component_craft_test.cpp"],
    deps = [":material_state_codec"],
    size = "small",
)
