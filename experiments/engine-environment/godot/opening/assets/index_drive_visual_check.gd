extends SceneTree
## Resource unit check only. No main scene, World, Session, body or player.

const Scene = preload("res://opening/assets/index_drive_visual.tscn")
var checks := 0
var failed := false
var seen_meshes: Dictionary = {}
var mesh_instances := 0

func verify(condition: bool, message: String) -> void:
	checks += 1
	if not condition:
		failed = true
		push_error(message)

func capture(node: Node3D) -> Array:
	var state: Array = [node.transform, node.visible]
	for child in node.get_children():
		state.append(capture(child))
	return state

func check_mesh(mesh: Mesh) -> void:
	if seen_meshes.has(mesh):
		return
	seen_meshes[mesh] = true
	verify(mesh.get_surface_count() > 0, "Every part has a mesh surface.")
	for surface in range(mesh.get_surface_count()):
		var arrays := mesh.surface_get_arrays(surface)
		var vertices: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
		var normals: PackedVector3Array = arrays[Mesh.ARRAY_NORMAL]
		var uvs: PackedVector2Array = arrays[Mesh.ARRAY_TEX_UV]
		var tangents: PackedFloat32Array = arrays[Mesh.ARRAY_TANGENT]
		verify(not vertices.is_empty() and normals.size() == vertices.size(), "Surfaces have explicit vertex normals.")
		verify(uvs.size() == vertices.size() and tangents.size() == vertices.size() * 4,
			"Machined surfaces provide UVs and tangent frames.")
		var finite := true
		var unit := true
		for i in range(vertices.size()):
			finite = finite and vertices[i].is_finite() and normals[i].is_finite() and uvs[i].is_finite()
			unit = unit and absf(normals[i].length_squared() - 1.0) < 0.002
			var tangent := Vector3(tangents[i * 4], tangents[i * 4 + 1], tangents[i * 4 + 2])
			finite = finite and tangent.is_finite() and is_finite(tangents[i * 4 + 3])
			unit = unit and absf(tangent.length_squared() - 1.0) < 0.02 and absf(tangent.dot(normals[i])) < 0.02
		verify(finite and unit, "Mesh coordinates and tangent frames remain finite and normalized.")

func check_tree(node: Node3D, assembly: Node3D) -> void:
	verify(node is Node3D and not node is CollisionObject3D and not node is CollisionShape3D,
		"The assembly consists only of presentation nodes.")
	verify(not node.is_processing() and not node.is_physics_processing(), "The asset has no frame or physics clock.")
	verify(node == assembly or node.get_script() == null, "Only the presentation root has a script.")
	if node is MeshInstance3D:
		mesh_instances += 1
		verify(node.material_override is StandardMaterial3D, "Parts use local lit material resources.")
		check_mesh(node.mesh)
	for child in node.get_children():
		check_tree(child, assembly)

func check_poses(assembly: Node3D) -> void:
	var carrier: Node3D = assembly.get_node("Carrier")
	var wheel: Node3D = assembly.get_node("Carrier/Wheel")
	var tool: Node3D = assembly.get_node("SideToolMount/Tool")
	var contact: MeshInstance3D = assembly.get_node("SideToolMount/ContactDisplay")
	var bed := capture(assembly.get_node("Bed"))
	verify(carrier.position.is_equal_approx(Vector3.ZERO) and wheel.basis.is_equal_approx(Basis.IDENTITY),
		"Instantiation starts at the neutral display pose.")
	verify(not contact.visible and tool.position.is_equal_approx(Vector3.ZERO), "The tool starts withdrawn.")
	# These are rendering inputs, not samples generated by a native authority.
	for sign_value in [-1.0, 1.0]:
		for quarter in range(4):
			var from: float = sign_value * quarter * PI / 2.0
			var target: float = from + sign_value * PI / 2.0
			for fraction in [0.0, 0.25, 0.5, 0.75, 1.0]:
				var angle: float = lerpf(from, target, fraction)
				var rotation := Basis(Vector3.UP, angle)
				verify(assembly.apply_visual_pose(fraction, rotation, false), "A finite outbound supplied pose is accepted.")
				verify(carrier.position.is_equal_approx(Vector3(2.0 * fraction, 0, 0)) and wheel.basis.is_equal_approx(rotation),
					"Only the supplied carrier and wheel transforms are displayed.")
			verify(assembly.apply_visual_pose(1.0, Basis(Vector3.UP, target), true), "A supplied work contact can be displayed.")
			verify(contact.visible and tool.position.is_equal_approx(Vector3(-0.22, 0, 0)), "Tool contact is an independent display input.")
			for fraction in [1.0, 0.75, 0.5, 0.25, 0.0]:
				verify(assembly.apply_visual_pose(fraction, Basis(Vector3.UP, target), false), "A supplied overrun return pose is accepted.")
				verify(wheel.basis.is_equal_approx(Basis(Vector3.UP, target)) and not contact.visible,
					"Return travel adds no wheel rotation or inferred contact.")
	verify(capture(assembly.get_node("Bed")) == bed, "Every supplied pose leaves the bed and markers fixed.")
	var before := capture(assembly)
	for fraction in [-0.001, 1.001, INF, -INF, NAN]:
		verify(not assembly.apply_visual_pose(fraction, Basis.IDENTITY, true) and capture(assembly) == before,
			"Invalid travel refuses the whole visual update.")
	for rotation in [Basis(Vector3.RIGHT, 0.1), Basis(Vector3.FORWARD, 0.1), Basis.FLIP_X,
			Basis.IDENTITY.scaled(Vector3(2, 1, 1)), Basis(Vector3(1, 0, 0), Vector3(0, 1, 0), Vector3(0.1, 0, 1)),
			Basis(Vector3(sqrt(0.99), 0.1, 0), Vector3.UP, Vector3.BACK),
			Basis(Vector3(NAN, 0, 0), Vector3.UP, Vector3.BACK),
			Basis(Vector3(INF, 0, 0), Vector3.UP, Vector3.BACK)]:
		verify(not assembly.apply_visual_pose(0.5, rotation, true) and capture(assembly) == before,
			"Invalid, reflected, sheared or tilted rotation preserves the complete preceding pose.")
	verify(assembly.apply_visual_pose(0.0, Basis.IDENTITY, true) and contact.visible,
		"The asset does not invent gameplay admission from the supplied pose.")

func _initialize() -> void:
	var assembly: Node3D = Scene.instantiate()
	var other: Node3D = Scene.instantiate()
	check_tree(assembly, assembly)
	var untouched := capture(other)
	check_poses(assembly)
	verify(capture(other) == untouched, "Two assemblies retain independent visual transforms.")
	verify(mesh_instances >= 60 and seen_meshes.size() >= 12, "The assembled mesh resource contains fitted mechanical parts.")
	assembly.free()
	other.free()
	print(JSON.stringify({"status": "fail" if failed else "pass", "checks": checks,
		"mesh_instances": mesh_instances, "unique_meshes": seen_meshes.size(),
		"native_pose_binding": "not_exercised", "rendered_quality": "not_assessed", "desktop": "not_used"}))
	quit(1 if failed else 0)
